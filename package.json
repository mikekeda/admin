{
  "name": "sass-compiler",
  "version": "0.0.1",
  "description": "compile sass",
  "main": "sass-compiller.js",
  "watches": {
    "sass": "sass/**"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "sass sass/style.scss static/css/style.css -s compressed",
    "watch:css": "sass --watch sass/style.scss static/css/style.css -s compressed",
    "start": "npm run build:css"
  },
  "keywords": [
    "sass"
  ],
  "author": "Mike",
  "license": "BSD-2-Clause",
  "dependencies": {
    "sass": "^1.108.2"
  }
}
